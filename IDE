#include <SPI.h>
#include <RF24.h>
#include "esp_bt.h"
#include "esp_wifi.h"
#include "esp_system.h"

// SPI Instances
SPIClass *sp = nullptr; // VSPI for radio1
SPIClass *hp = nullptr; // HSPI for radio

// RF24 Objects: CE, CSN, Speed
// HSPI: CE=27, CSN=15
RF24 radio(27, 15, 16000000); 

// VSPI: CE=22, CSN=21
RF24 radio1(22, 21, 16000000); 

/* 
   Pin Mapping Reference:
   HSPI: SCK=14, MISO=12, MOSI=13, CS=15, CE=27
   VSPI: SCK=18, MISO=19, MOSI=23, CS=21, CE=22
*/

int ch = 45;  // Initial channel for HSPI
int ch1 = 45; // Initial channel for VSPI

// Function to properly disable WiFi and Bluetooth
void disableWiFiAndClassicBT() {
  Serial.println("Disabling WiFi and Bluetooth...");
  
  // 1. Disable WiFi completely using low-level functions
  esp_wifi_stop();
  esp_wifi_deinit();

  // 2. Disable Bluetooth completely
  btStop(); 
  
  Serial.println("WiFi & Bluetooth Disabled Successfully.");
}

void aggressiveRandomMode() {
  // AGGRESSIVE RANDOM MODE LOGIC
  uint8_t randCh1 = random(80);
  uint8_t randCh = random(80);
  
  radio1.setChannel(randCh1);
  radio.setChannel(randCh);
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  // Set CPU to max frequency for fastest processing
  setCpuFrequencyMhz(240);
  
  // Kill Bluetooth and WiFi properly
  disableWiFiAndClassicBT();
  
  Serial.println("Wireless Interfaces Disabled. Starting...");
  
  initHP(); // Initialize HSPI Radio
  initSP(); // Initialize VSPI Radio

  // Print initial mode status
  delay(500);
  Serial.println("\n========================================");
  Serial.println(" RUNNING IN: AGGRESSIVE RANDOM MODE");
  Serial.println(" (Locked to Random Mode, Button Removed)");
  Serial.println("========================================");
}

void initSP() {
  sp = new SPIClass(VSPI);
  sp->begin(18, 19, 23, 21); // Explicitly define pins for VSPI: SCK, MISO, MOSI, CS
  if (radio1.begin(sp)) {
    Serial.println("VSPI (Radio1) Started !!!");
    radio1.setAutoAck(false);
    radio1.stopListening(); 
    radio1.setRetries(0, 0);
    radio1.setPALevel(RF24_PA_MAX, true); 
    radio1.setDataRate(RF24_2MBPS);       
    radio1.setCRCLength(RF24_CRC_DISABLED); 
    radio1.printPrettyDetails();
    radio1.startConstCarrier(RF24_PA_MAX, ch1);
  } else {
    Serial.println("VSPI (Radio1) couldn't start !!!");
  }
}

void initHP() {
  hp = new SPIClass(HSPI);
  hp->begin(14, 12, 13, 15); // Explicitly define pins for HSPI: SCK, MISO, MOSI, CS
  if (radio.begin(hp)) {
    Serial.println("HSPI (Radio) Started !!!");
    radio.setAutoAck(false);
    radio.stopListening(); 
    radio.setRetries(0, 0);
    
    radio.setPALevel(RF24_PA_MAX, true); // Max Power
    radio.setDataRate(RF24_2MBPS);       // Fastest data rate
    radio.setCRCLength(RF24_CRC_DISABLED); // Disable CRC
    radio.printPrettyDetails();
    radio.startConstCarrier(RF24_PA_MAX, ch);
  } else {
    Serial.println("HSPI (Radio) couldn't start !!!");
  }
}

void loop() {
  // Continuously execute Aggressive Random Mode without any button checks
  aggressiveRandomMode();
}
